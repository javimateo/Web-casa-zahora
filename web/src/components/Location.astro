---
import Txt from './Txt.astro';
import { casa } from '../data/casa';
import type { Textos } from '../i18n/es';
interface Props { t: Textos }
const u = Astro.props.t.ubicacion;
const mapa = { casa: { ...casa.coordenadas, nombre: casa.nombre }, lugares: u.lugares };
---
<section class="location" id="ubicacion" aria-labelledby="t-ubi">
  <div class="wrap">
    <h2 id="t-ubi">{u.titulo}</h2>
    <p class="lead">{u.lead}</p>
    <div class="location-grid">
      <div class="map" id="map" role="region" aria-label={u.mapaLabel} data-mapa={JSON.stringify(mapa)}></div>
      <div class="distances">
        {u.grupos.map((g) => (
          <>
            <p class="label">{g.titulo}</p>
            <dl>{g.items.map(([lugar, tiempo]) => <div><dt>{lugar}</dt><dd><Txt t={tiempo} /></dd></div>)}</dl>
          </>
        ))}
        <p class="note">{u.nota}</p>
        <a class="text-link" href="#">{u.comoLlegar}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // El mapa (Leaflet + OpenStreetMap) solo se carga cuando la sección se acerca a la pantalla
  const el = document.getElementById('map');
  if (el) {
    const init = async () => {
      const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
      const { casa, lugares } = JSON.parse(el.dataset.mapa!);
      const map = L.map(el, { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      const centro: [number, number] = [casa.lat, casa.lng];
      // Zona aproximada de la casa: no se publica la ubicación exacta
      L.circle(centro, { radius: 450, color: '#A2583C', weight: 1.5, fillColor: '#A2583C', fillOpacity: 0.16 })
        .addTo(map)
        .bindTooltip(casa.nombre, { permanent: true, direction: 'top', className: 'map-label home', offset: [0, -14] });
      const offset: Record<string, [number, number]> = { left: [-8, 0], right: [8, 0], top: [0, -8], bottom: [0, 8] };
      const puntos: [number, number][] = [centro];
      for (const l of lugares as { nombre: string; lat: number; lng: number; dir: 'left' | 'right' | 'top' | 'bottom' }[]) {
        const pos: [number, number] = [l.lat, l.lng];
        puntos.push(pos);
        L.circleMarker(pos, { radius: 5, color: '#2C3120', weight: 1.5, fillColor: '#F7F7F4', fillOpacity: 1 })
          .addTo(map)
          .bindTooltip(l.nombre, { permanent: true, direction: l.dir, className: 'map-label', offset: offset[l.dir] });
      }
      map.fitBounds(L.latLngBounds(puntos).pad(0.15));
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); init(); }
    }, { rootMargin: '400px 0px' });
    io.observe(el);
  }
</script>
