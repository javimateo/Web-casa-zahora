---
import Foto from './Foto.astro';
import Icon from './Icon.astro';
import type { Textos } from '../i18n/es';
interface Props { t: Textos }
const { zona: z, temporadas: s } = Astro.props.t;
---
<section id="zona" aria-labelledby="t-zona">
  <div class="wrap">
    <h2 id="t-zona">{z.titulo}</h2>
    <p class="lead">{z.lead}</p>
    <ul class="area-grid">
      {z.items.map((it) => (
        <li>
          <Foto src={it.foto} alt={it.alt} sizes="(max-width: 760px) 92vw, 30vw" widths={[480, 800, 1200]} />
          <h3>{it.titulo}</h3>
          <p>{it.texto}</p>
        </li>
      ))}
    </ul>
    <p class="area-foot"><a class="text-link" href="#">{z.guia}</a></p>
  </div>
</section>

<section class="seasons" id="temporadas" aria-labelledby="t-temp">
  <div class="wrap">
    <h2 id="t-temp">{s.titulo}</h2>
    <div class="seasons-grid">
      {s.items.map((it) => (
        <article class="season">
          <Foto src={it.foto} alt={it.alt} sizes="(max-width: 760px) 92vw, 30vw" widths={[480, 800]} />
          <span class="label">{it.cuando}</span>
          <h3>{it.titulo}</h3>
          <p>{it.texto}</p>
        </article>
      ))}
    </div>
    <div class="wind">
      <Icon name="wind" />
      <p><b>{s.levanteTitulo}</b> {s.levante}</p>
    </div>
  </div>
</section>
