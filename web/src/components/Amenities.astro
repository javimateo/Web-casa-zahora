---
import Txt from './Txt.astro';
import type { Textos } from '../i18n/es';
interface Props { t: Textos }
const e = Astro.props.t.equipamiento;
---
<section id="equipamiento" aria-labelledby="t-equipo">
  <div class="wrap">
    <h2 id="t-equipo">{e.titulo}</h2>
    <div class="amenities-grid">
      {e.grupos.map((g) => (
        <div><h3>{g.titulo}</h3><ul>{g.items.map((it) => <li><Txt t={it} /></li>)}</ul></div>
      ))}
    </div>
    <div class="floors">
      {e.plantas.map((p) => (
        <div>
          <h3>{p.titulo}</h3>
          <dl>{p.estancias.map(([sala, desc]) => <div><dt>{sala}</dt><dd><Txt t={desc} /></dd></div>)}</dl>
        </div>
      ))}
    </div>
  </div>
</section>
