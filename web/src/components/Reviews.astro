---
import Txt from './Txt.astro';
import { casa } from '../data/casa';
import type { Textos } from '../i18n/es';
interface Props { t: Textos }
const { opiniones: o, faq } = Astro.props.t;
const v = casa.valoracion;
const resumen = o.resumen.replace('{total}', v.total || 'XX').replace('{plataforma}', v.plataforma);
---
<section class="reviews" id="opiniones" aria-labelledby="t-opi">
  <div class="wrap">
    <h2 id="t-opi">{o.titulo}</h2>
    <ul class="reviews-grid">
      {o.items.map((r) => <li><blockquote>{r.texto}</blockquote><cite><Txt t={r.autor} /></cite></li>)}
    </ul>
    <p class="reviews-summary">
      <strong class="num">{v.nota || 'X,X'}</strong> <Txt t={v.nota ? resumen : `${resumen}*`} />.
      {' '}<a class="text-link" href={v.urlOpiniones || '#'}>{o.leerTodas}</a>
    </p>
  </div>
</section>

<section class="faq" id="faq" aria-labelledby="t-faq">
  <div class="wrap">
    <h2 id="t-faq">{faq.titulo}</h2>
    {faq.items.map((f, i) => (
      <details open={i === 0}><summary>{f.p}</summary><p><Txt t={f.r} /></p></details>
    ))}
  </div>
</section>
